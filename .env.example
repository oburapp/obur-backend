# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Serves /docs, /redoc, /openapi.json. True is a deliberate choice (small
# API surface, no sensitive data behind it, project is open source), not
# an unexamined framework default, see docs/threat-model.md, API8.
ENABLE_API_DOCS=true

# Database (PostgreSQL + PostGIS)
# POSTGRES_* are read by docker-compose.yml to provision the local
# container — keep them in sync with the credentials embedded in
# DATABASE_URL below, which is what the app itself actually connects with.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=obur
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/obur
# If port 5432 is already taken on your machine (e.g. a native Postgres
# install), uncomment and change both of these together:
# POSTGRES_PORT=5433
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/obur

# Application database role (ADR-0016 in obur-docs): the running API
# connects as this role, never as the owner role above. APP_DB_ROLE_PASSWORD
# is read directly by the migration that creates the role
# (migrations/versions/f3a8c1d92b47_*.py) — keep it in sync with the
# credentials embedded in APP_DATABASE_URL below, the same relationship
# POSTGRES_PASSWORD/DATABASE_URL already have above.
APP_DB_ROLE_PASSWORD=change-me-to-a-long-random-string
APP_DATABASE_URL=postgresql+asyncpg://obur_app:change-me-to-a-long-random-string@localhost:5432/obur

# Cache (Redis)
REDIS_URL=redis://localhost:6379/0
# Same idea if 6379 is taken:
# REDIS_PORT=6380
# REDIS_URL=redis://localhost:6380/0

# Auth (Clerk)
CLERK_SECRET_KEY=
# From the Clerk Dashboard once a webhook endpoint is registered there
# (needs a public URL — see docs/roadmap.md Phase 1). Empty until then.
CLERK_WEBHOOK_SECRET=

# Rate limiting (see ADR-0014 in obur-docs)
# Keys the anonymous counter. Any long random string; rotating it resets
# every in-flight anonymous window, which is harmless.
RATE_LIMIT_SECRET=change-me-to-a-long-random-string
# Reverse proxies between the internet and the app. 0 locally. Set this to
# the real hop count per deployment: too high and the limiter reads a
# client-controlled value, too low and it lumps everyone behind the proxy
# into one counter. Neither failure is loud.
TRUSTED_PROXY_COUNT=0

# Storage (Cloudflare R2, S3-compatible via boto3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
