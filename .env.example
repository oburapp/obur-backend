# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/obur

# Cache (Redis)
REDIS_URL=redis://localhost:6379/0

# Auth (Clerk)
CLERK_SECRET_KEY=

# Storage (Cloudflare R2, S3-compatible via boto3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
